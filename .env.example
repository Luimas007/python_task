# ---------- PostgreSQL (the ONLY knowledge base) ----------
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_password_here
PG_DATABASE=samsung_kb

# ---------- Scraper ----------
SCRAPE_TARGET_COUNT=30
SCRAPE_DELAY_SECONDS=2.5
SCRAPE_IMPERSONATE=chrome
SCRAPE_TIMEOUT=40
SCRAPE_MAX_RETRIES=3

# ---------- Embeddings (CPU) ----------
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIM=384
EMBED_BATCH=32

# ---------- LLM (Ollama, local GPU) ----------
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT=180

# ---------- Retrieval ----------
RAG_TOP_K=8
RAG_MIN_SCORE=0.15

# ---------- API ----------
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
